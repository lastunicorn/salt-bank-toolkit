root = true

[*]
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
charset = utf-8-bom
indent_style = tab
indent_size = 4

[*.{csproj,props,targets,slnx}]
charset = utf-8-bom
indent_style = tab
indent_size = 4

# YAML forbids tabs — must stay on spaces
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
