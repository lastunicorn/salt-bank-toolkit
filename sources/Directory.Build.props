<Project>

    <PropertyGroup>
        <Company>Dust in the Wind</Company>
        <Product>Salt Bank Toolkit</Product>
        <Copyright>Copyright © 2026 Dust in the Wind</Copyright>
        <Version>1.0.0.0</Version>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <PackageProjectUrl>https://github.com/lastunicorn/salt-bank-toolkit</PackageProjectUrl>
        <RepositoryUrl>https://github.com/lastunicorn/salt-bank-toolkit</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\LICENSE.txt" Link="LICENSE" Pack="true" PackagePath="LICENSE" />
        <Content Include="..\README.md" Link="README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

</Project>
